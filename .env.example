# ─── REQUIRED — Supabase ─────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── REQUIRED — App ──────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=Uggalla Oil Mills
NEXT_PUBLIC_CURRENCY=LKR

# ─── OPTIONAL — Google OAuth ─────────────────────────────────────────────────
# Set NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=true to show the "Continue with Google" button.
# Leave blank (or false) to hide Google OAuth — email/password always works.
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── OPTIONAL — Admin Seed ───────────────────────────────────────────────────
# Used by: npm run seed-admin
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# ─── OPTIONAL — PayHere (payments) ──────────────────────────────────────────
# Leave blank to disable online payments — bulk quotes become offline-only.
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_MODE=sandbox
PAYHERE_NOTIFY_URL=
PAYHERE_RETURN_URL=
PAYHERE_CANCEL_URL=

# ─── OPTIONAL — Resend (email) ───────────────────────────────────────────────
# Leave blank to skip transactional emails.
RESEND_API_KEY=
RESEND_FROM_EMAIL=orders@uggallaoilmills.lk

# ─── OPTIONAL — WhatsApp Cloud API ──────────────────────────────────────────
# Leave blank to disable WhatsApp notifications.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=

# ─── OPTIONAL — Vercel Cron ──────────────────────────────────────────────────
CRON_SECRET=

# ─── OPTIONAL — Analytics ────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=
